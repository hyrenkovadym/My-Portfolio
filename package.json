{
  "name": "my-portfolio-platform",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "postinstall": "pnpm --filter api prisma:generate",
    "dev": "pnpm --parallel --filter api --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter api build && pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "lint:api": "pnpm --filter api lint",
    "test": "pnpm --filter api test",
    "test:api": "pnpm --filter api test",
    "test:e2e": "pnpm --filter web test:e2e",
    "prisma:generate": "pnpm --filter api prisma:generate",
    "prisma:migrate": "pnpm --filter api prisma:migrate",
    "prisma:seed": "pnpm --filter api prisma:seed",
    "prisma:studio": "pnpm --filter api prisma:studio"
  },
  "packageManager": "pnpm@10.30.3"
}

